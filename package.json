{
	"name": "open-grind",
	"version": "0.1.0-beta.4",
	"license": "MIT",
	"author": "Open Grind Governance (https://opengrind.org/governance)",
	"type": "module",
	"scripts": {
		"postinstall": "bun run patch-deps",
		"build": "bun run patch-deps && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:tools": "bun x tsc --noEmit -p tsconfig.tools.json",
		"check:config": "opengrind-config check",
		"check:deps": "cargo deny --manifest-path src-tauri/Cargo.toml check && bun audit && bun audit --cwd docs",
		"bump": "bun scripts/bump-version.ts",
		"check:version": "bun scripts/check-version.ts",
		"check:backup-rules": "bun scripts/check-backup-rules.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "bun dev:desktop",
		"dev:android": "bash scripts/dev-android.sh",
		"dev:desktop": "tauri dev --features devtools",
		"docs": "bun run --cwd docs start",
		"format": "prettier --write .",
		"gen:icons": "bash scripts/gen-icons.sh",
		"package:macos": "nix run .#build-macos --",
		"lint": "svelte-kit sync && eslint --concurrency=2 .",
		"preview": "vite preview",
		"sync-config": "opengrind-config sync",
		"tauri": "tauri",
		"patch-deps": "bun scripts/patch-deps.ts",
		"test": "bun run test:unit && bun run test:rust",
		"test:rust": "bun run patch-deps && cargo test --manifest-path src-tauri/Cargo.toml --lib",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:unit": "svelte-kit sync && vitest run",
		"test:e2e": "playwright test",
		"dev:updater-server": "bun scripts/updater-release-server.ts",
		"test:android": "cd src-tauri/gen/android && ./gradlew :app:testUniversalReleaseUnitTest",
		"test:android-logic": "src-tauri/gen/android/gradlew -p src-tauri/android-logic test"
	},
	"overrides": {
		"brace-expansion": "^5.0.9",
		"cookie": "^0.7.0",
		"nanoid": "^3.3.18",
		"postcss": "^8.5.24",
		"valibot": "^1.4.2",
		"vite": "^6.4.3"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@msgpack/msgpack": "^3.1.3",
		"@tailwindcss/vite": "^4.2.4",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "~2",
		"@tauri-apps/plugin-fs": "~2.5.1",
		"@tauri-apps/plugin-geolocation": "~2.3.2",
		"@tauri-apps/plugin-opener": "~2.5",
		"@tauri-apps/plugin-os": "~2.3.2",
		"brace-expansion": "^5.0.9",
		"date-fns": "^4.1.0",
		"paneforge": "^1.0.2",
		"photoswipe": "^5.4.4",
		"postcss": "^8.5.24",
		"sveaflet": "^0.1.4",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.2.4",
		"tauri-plugin-android-fs-api": "28.2.2",
		"tinykeys": "^4.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@opengrind/config": "^1.3.1",
		"@types/bun": "^1.3.14",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tauri-apps/cli": "^2.11.1",
		"@testing-library/svelte": "^5.2.8",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/leaflet": "^1.9.21",
		"@vitest/coverage-v8": "^4.1.5",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.3.0",
		"jsdom": "^26.1.0",
		"lefthook": "^2.1.10",
		"phosphor-svelte": "^3.1.0",
		"prettier": "^3.8.3",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^6.4.3",
		"vitest": "^4.1.5"
	},
	"patchedDependencies": {
		"vaul-svelte@1.0.0-next.7": "patches/vaul-svelte@1.0.0-next.7.patch",
		"@sveltejs/kit@2.70.2": "patches/@sveltejs%2Fkit@2.70.2.patch",
		"svelte-sonner@1.1.1": "patches/svelte-sonner@1.1.1.patch"
	}
}
