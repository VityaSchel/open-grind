{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Open Grind",
	"version": "0.1.0-beta.3",
	"identifier": "org.opengrind",
	"build": {
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Open Grind",
				"width": 1000,
				"height": 800,
				"minWidth": 320,
				"minHeight": 300,
				"theme": "Dark",
				"userAgent": "OpenGrind/0.1.0 (+https://opengrind.org/; contact: admin@opengrind.org)",
				"titleBarStyle": "Visible",
				"backgroundColor": "#1e1e1e"
			}
		],
		"security": {
			"csp": null,
			"dangerousDisableAssetCspModification": [
				"script-src"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"signingIdentity": "tauri-dev"
		},
		"android": {
			"autoIncrementVersionCode": false,
			"minSdkVersion": 28,
			"versionCode": 1020
		}
	}
}
