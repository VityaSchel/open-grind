diff --git b/src/android/stream.rs b/src/android/stream.rs
new file mode 100644
index 0000000..755e1e8
--- /dev/null
+++ b/src/android/stream.rs
@@ -0,0 +1,169 @@
+// Copyright 2020-2023 Tauri Programme within The Commons Conservancy
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-License-Identifier: MIT
+
+use std::{
+  collections::HashMap,
+  io,
+  panic::{catch_unwind, AssertUnwindSafe},
+  sync::{
+    atomic::{AtomicU64, Ordering},
+    Arc, Mutex, MutexGuard, PoisonError,
+  },
+};
+
+use jni::{
+  objects::{JByteArray, JClass},
+  sys::{jbyte, jint, jlong, jsize},
+  JNIEnv,
+};
+use once_cell::sync::Lazy;
+
+/// Response header naming the [`register_stream`] id whose stream becomes the body.
+pub const STREAM_HEADER: &str = "x-wry-stream";
+
+/// A response body with `java.io.InputStream` semantics.
+pub trait ResponseStream: Send {
+  fn available(&mut self) -> io::Result<u64>;
+  fn skip(&mut self, n: u64) -> io::Result<u64>;
+  /// `Ok(0)` is end of stream.
+  fn read(&mut self, buf: &mut [u8]) -> io::Result<usize>;
+  /// Must not block.
+  fn close(&mut self);
+}
+
+type Entry = Arc<Mutex<Box<dyn ResponseStream>>>;
+
+static STREAMS: Lazy<Mutex<HashMap<u64, Entry>>> = Lazy::new(Default::default);
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+
+fn streams() -> MutexGuard<'static, HashMap<u64, Entry>> {
+  STREAMS.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+pub fn register_stream(stream: Box<dyn ResponseStream>) -> u64 {
+  let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+  streams().insert(id, Arc::new(Mutex::new(stream)));
+  id
+}
+
+pub fn unregister_stream(id: u64) -> bool {
+  let Some(entry) = streams().remove(&id) else {
+    return false;
+  };
+  let closed = entry.try_lock().map(|mut stream| stream.close()).is_ok();
+  if !closed {
+    std::thread::spawn(move || {
+      if let Ok(mut stream) = entry.lock() {
+        stream.close();
+      }
+    });
+  }
+  true
+}
+
+fn with_stream<T>(
+  handle: jlong,
+  body: impl FnOnce(&mut dyn ResponseStream) -> io::Result<T>,
+) -> io::Result<T> {
+  let entry = streams()
+    .get(&(handle as u64))
+    .cloned()
+    .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "unknown stream"))?;
+  let mut stream = entry
+    .lock()
+    .map_err(|_| io::Error::other("stream poisoned"))?;
+  body(&mut **stream)
+}
+
+fn guarded<T>(
+  env: &mut JNIEnv,
+  sentinel: T,
+  body: impl FnOnce(&mut JNIEnv) -> io::Result<T>,
+) -> T {
+  match catch_unwind(AssertUnwindSafe(|| body(env))) {
+    Ok(Ok(value)) => value,
+    Ok(Err(error)) => {
+      throw(env, &error.to_string());
+      sentinel
+    }
+    Err(_) => {
+      throw(env, "stream panicked");
+      sentinel
+    }
+  }
+}
+
+fn throw(env: &mut JNIEnv, message: &str) {
+  if env.exception_check().unwrap_or(true) {
+    return;
+  }
+  let _ = env.throw_new("java/io/IOException", message);
+}
+
+fn read_bounds(capacity: jsize, offset: jint, length: jint) -> io::Result<(jsize, usize)> {
+  match offset.checked_add(length) {
+    Some(end) if offset >= 0 && length >= 0 && end <= capacity => Ok((offset, length as usize)),
+    _ => Err(io::Error::new(
+      io::ErrorKind::InvalidInput,
+      "read range outside the buffer",
+    )),
+  }
+}
+
+fn as_jbytes(bytes: &[u8]) -> &[jbyte] {
+  unsafe { std::slice::from_raw_parts(bytes.as_ptr().cast::<jbyte>(), bytes.len()) }
+}
+
+#[allow(non_snake_case)]
+pub unsafe fn streamAvailable(mut env: JNIEnv, _: JClass, handle: jlong) -> jint {
+  guarded(&mut env, 0, |_| {
+    with_stream(handle, |stream| stream.available()).map(|n| n.min(jint::MAX as u64) as jint)
+  })
+}
+
+#[allow(non_snake_case)]
+pub unsafe fn streamSkip(mut env: JNIEnv, _: JClass, handle: jlong, n: jlong) -> jlong {
+  guarded(&mut env, 0, |_| {
+    if n <= 0 {
+      return Ok(0);
+    }
+    with_stream(handle, |stream| stream.skip(n as u64))
+      .map(|skipped| skipped.min(jlong::MAX as u64) as jlong)
+  })
+}
+
+#[allow(non_snake_case)]
+pub unsafe fn streamRead(
+  mut env: JNIEnv,
+  _: JClass,
+  handle: jlong,
+  buffer: JByteArray,
+  offset: jint,
+  length: jint,
+) -> jint {
+  guarded(&mut env, -1, |env| {
+    let capacity = env.get_array_length(&buffer).map_err(io::Error::other)?;
+    let (offset, length) = read_bounds(capacity, offset, length)?;
+    if length == 0 {
+      return Ok(0);
+    }
+    let mut chunk = vec![0u8; length];
+    let read = with_stream(handle, |stream| stream.read(&mut chunk))?;
+    if read == 0 {
+      return Ok(-1);
+    }
+    env
+      .set_byte_array_region(&buffer, offset, as_jbytes(&chunk[..read]))
+      .map_err(io::Error::other)?;
+    Ok(read as jint)
+  })
+}
+
+#[allow(non_snake_case)]
+pub unsafe fn streamClose(mut env: JNIEnv, _: JClass, handle: jlong) {
+  guarded(&mut env, (), |_| {
+    unregister_stream(handle as u64);
+    Ok(())
+  })
+}
