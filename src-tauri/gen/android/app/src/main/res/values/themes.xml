<resources xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">
	<style name="Theme.open_grind" parent="Theme.MaterialComponents.DayNight.NoActionBar">
		<item name="android:windowBackground">@color/brand_background</item>
	</style>

	<style name="ThemeOverlay.OpenGrind.WebViewDialog"
		parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
		<item name="colorSurface">@color/brand_surface</item>
		<item name="colorOnSurface">@color/brand_on_surface</item>
		<item name="colorPrimary">@color/brand_primary</item>
		<item name="colorOnPrimary">@color/brand_on_primary</item>
		<item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.OpenGrind.Dialog</item>
		<item name="android:dialogCornerRadius" tools:targetApi="p">20dp</item>
		<item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
	</style>

	<style name="ShapeAppearance.OpenGrind.Dialog"
		parent="ShapeAppearance.MaterialComponents.MediumComponent">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">20dp</item>
	</style>

	<style name="TextAppearance.OpenGrind.Button" parent="TextAppearance.MaterialComponents.Button">
		<item name="android:textAllCaps">false</item>
		<item name="textAllCaps">false</item>
		<item name="android:letterSpacing">0</item>
	</style>

	<style name="Widget.OpenGrind.Dialog.Button.Filled"
		parent="Widget.MaterialComponents.Button.UnelevatedButton">
		<item name="android:textAppearance">@style/TextAppearance.OpenGrind.Button</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:letterSpacing">0</item>
		<item name="backgroundTint">@color/brand_primary</item>
		<item name="android:textColor">@color/brand_on_primary</item>
		<item name="rippleColor">@color/brand_on_primary</item>
		<item name="cornerRadius">12dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:minHeight">52dp</item>
	</style>

	<style name="Widget.OpenGrind.Dialog.Button.Text"
		parent="Widget.MaterialComponents.Button.TextButton">
		<item name="android:textAppearance">@style/TextAppearance.OpenGrind.Button</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:letterSpacing">0</item>
		<item name="android:textColor">@color/brand_on_surface_variant</item>
		<item name="rippleColor">@color/brand_primary</item>
		<item name="cornerRadius">12dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:minHeight">52dp</item>
	</style>
</resources>