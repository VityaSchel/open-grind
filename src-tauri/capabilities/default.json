{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Shared capability for all platforms",
	"windows": [
		"main"
	],
	"permissions": [
		"core:default",
		"os:default",
		"opener:default",
		{
			"identifier": "opener:allow-open-url",
			"deny": [
				{
					"url": "http://tauri.localhost*"
				},
				{
					"url": "https://tauri.localhost*"
				},
				{
					"url": "http://ogmedia.localhost*"
				},
				{
					"url": "http://localhost*"
				},
				{
					"url": "http://127.0.0.1*"
				}
			]
		},
		"clipboard-manager:default",
		"clipboard-manager:allow-write-text",
		"dialog:allow-open"
	]
}