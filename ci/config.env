OPEN_GRIND_BOXES="${OPEN_GRIND_BOXES:-a b c}"

# CherryServers (a)
# G1-8-32gb-200nv-ded: 8 dedicated-vCPU Intel Gold cores, 32 GB RAM
# Regions: Šiauliai (Lithuania), Amsterdam, Chicago, Singapore
OPEN_GRIND_CHERRY_PLAN="${OPEN_GRIND_CHERRY_PLAN:-G1-8-32gb-200nv-ded}"
OPEN_GRIND_CHERRY_REGIONS="${OPEN_GRIND_CHERRY_REGIONS:-LT-Siauliai NL-Amsterdam US-Chicago SG-Singapore}"

# Vultr (b)
# vhp-8c-16gb-amd: 8 vCPU AMD EPYC, 16 GB RAM
# Regions: Amsterdam, Frankfurt, Paris, Warsaw, Madrid, Newark, Chicago, Dallas–Fort Worth, San Jose / Silicon Valley, Los Angeles, Miami, Singapore
OPEN_GRIND_VULTR_PLAN="${OPEN_GRIND_VULTR_PLAN:-vhp-8c-16gb-amd}"
OPEN_GRIND_VULTR_REGIONS="${OPEN_GRIND_VULTR_REGIONS:-ams fra cdg waw mad ewr ord dfw sjc lax mia sgp}"

# Hetzner (c)
# cx43: 8 vCPU Intel, 16 GB RAM
# cpx42: 8 vCPU AMD, 16 GB RAM
# Regions: Falkenstein, Nuremberg, Helsinki
OPEN_GRIND_HETZNER_PLANS="${OPEN_GRIND_HETZNER_PLANS:-cx43 cpx42}"
OPEN_GRIND_HETZNER_LOCATIONS="${OPEN_GRIND_HETZNER_LOCATIONS:-fsn1 nbg1 hel1}"

# Scaleway (d)
# PRO2-S: 8 vCPU AMD EPYC, 32 GB RAM
# Regions: Paris, Amsterdam, Warsaw
OPEN_GRIND_SCALEWAY_PLAN="${OPEN_GRIND_SCALEWAY_PLAN:-PRO2-S}"
OPEN_GRIND_SCALEWAY_ZONES="${OPEN_GRIND_SCALEWAY_ZONES:-fr-par-1 fr-par-2 nl-ams-1 nl-ams-2 pl-waw-1 pl-waw-2}"

# DigitalOcean (e)
# s-8vcpu-16gb: 8 vCPU, 16 GB RAM
# Regions: Frankfurt, Amsterdam, London
OPEN_GRIND_DIGITALOCEAN_SIZE="${OPEN_GRIND_DIGITALOCEAN_SIZE:-s-8vcpu-16gb}"
OPEN_GRIND_DIGITALOCEAN_REGIONS="${OPEN_GRIND_DIGITALOCEAN_REGIONS:-fra1 ams3 lon1}"
