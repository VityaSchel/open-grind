# Maintainer: Open Grind Governance <https://opengrind.org/governance>

pkgname=open-grind-bin
_pkgname=open-grind
_ver=0.1.0-rc.1
# pacman reads '-' as the pkgver/pkgrel separator, so it cannot stay.
# Dropping it sorts 0.1.0beta.4 below 0.1.0. An underscore sorts it
# above, which would need an epoch to undo. Checked with pacman's vercmp.
pkgver="${_ver/-/}"
pkgrel=1
_tag="v$_ver"
pkgdesc='Unofficial FLOSS Grindr client'
arch=('x86_64' 'aarch64')
url='https://opengrind.org'
license=('MIT')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('!strip')

makedepends=('minisign')

depends=(
	cairo
	dbus
	gdk-pixbuf2
	glib2
	glibc
	gtk3
	hicolor-icon-theme
	libgcc
	libsoup3
	pango
	webkit2gtk-4.1
)

optdepends=(
	'gst-plugins-good: audio and video playback in chat and albums'
	'gst-libav: additional H.264/AAC media decoding'
	'xdg-utils: opening links and files in external applications'
)

_releases="https://git.opengrind.org/open-grind/open-grind/releases/download/$_tag"

# Upstream names its assets the Debian way, so aarch64 pulls "-arm64".
source=("$pkgname-$pkgver-LICENSE::https://git.opengrind.org/open-grind/open-grind/raw/tag/$_tag/LICENSE")
source_x86_64=(
	"$pkgname-$pkgver-x86_64.deb::$_releases/$_pkgname-$_tag-linux-x86_64.deb"
	"$pkgname-$pkgver-x86_64.deb.minisig::$_releases/$_pkgname-$_tag-linux-x86_64.deb.minisig"
)
source_aarch64=(
	"$pkgname-$pkgver-aarch64.deb::$_releases/$_pkgname-$_tag-linux-arm64.deb"
	"$pkgname-$pkgver-aarch64.deb.minisig::$_releases/$_pkgname-$_tag-linux-arm64.deb.minisig"
)

sha256sums=('18b347191b86bde3646ab8c21910f01fda8d3d2caca5ebc8fe402a62f3425f5e')
sha256sums_x86_64=('80e27be35b22cc7c027841ac46653ed9c201963ee912ee10f4bdae064a291e28'
                   'ad1e23d129d9a74d52b7cdb939160727b4fc8a880ce32c468f51eda3caecab8b')
sha256sums_aarch64=('6f715f4d89593944fd4edd59a241223ac414c6c01d0d981334413a0875b6e347'
                    '5203efa600fd82054f11f2d94d2337cd341a55fbf32109b13533101dfb23f56a')

# Published in the project's KEYS.md.
_minisign_key='RWReleaseOpenGrindurRQcmR+NovOaU5IEU3LM5l6TcXJvOGYw2m4O+'

verify() {
	# makepkg runs this from $startdir, but downloads go to $SRCDEST, and
	# those are the same place only when SRCDEST is unset.
	local deb="$pkgname-$pkgver-$CARCH.deb"
	[[ -f $deb ]] || deb="$SRCDEST/$deb"
	minisign -V -P "$_minisign_key" -m "$deb" -x "$deb.minisig"
}

package() {
	# makepkg's bsdtar already unpacked the .deb, so the payload is what is left.
	bsdtar -xf data.tar.gz -C "$pkgdir"
	install -Dm644 "$pkgname-$pkgver-LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
